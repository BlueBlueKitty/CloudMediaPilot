# CloudMediaPilot 配置示例（单 config 目录模式）
# 说明：建议将本文件复制到 config/.env，WebUI 保存后也会写入该文件。

# TMDB
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_USE_PROXY=false
TMDB_API_KEY=
ENABLE_TMDB=true

# 搜索引擎
PROWLARR_BASE_URL=http://localhost:9696
PROWLARR_API_KEY=
PROWLARR_USE_PROXY=false
ENABLE_PROWLARR=true
PANSOU_BASE_URL=http://localhost:805
PANSOU_USE_PROXY=false
PANSOU_ENABLE_AUTH=false
PANSOU_USERNAME=
PANSOU_PASSWORD=
PANSOU_SEARCH_PATH=/api/search
PANSOU_SEARCH_METHOD=POST
PANSOU_CLOUD_TYPES=
PANSOU_SEARCH_LIMIT_ENABLED=true
PANSOU_SEARCH_LIMIT=500
ENABLE_PANSOU=true
PROWLARR_SEARCH_LIMIT_ENABLED=true
PROWLARR_SEARCH_LIMIT=100

# 115
C115_BASE_URL=https://lixian.115.com
C115_COOKIE=
C115_ALLOWED_ACTIONS=create_offline_task
C115_TARGET_DIR_ID=0
C115_TARGET_DIR_PATH=/
C115_OFFLINE_DIR_ID=0
C115_OFFLINE_DIR_PATH=/
C115_OFFLINE_ADD_PATH=/lixianssp/?ac=add_task_url
C115_OFFLINE_LIST_PATH=/web/lixian/?ac=task_lists
STORAGE_PROVIDERS=115,quark,aliyun,baidu,uc,pikpak,xunlei
QUARK_COOKIE=
ALIYUN_REFRESH_TOKEN=
BAIDU_COOKIE=
UC_COOKIE=
PIKPAK_REFRESH_TOKEN=
XUNLEI_TOKEN=

# 资源过滤与清理
RESOURCE_FILTER_ENABLED=true
RESOURCE_FILTER_RULES=[{"id":"doc-text-files","name":"文档和文本文件","enabled":true,"glob":"*.txt","min_size_mb":null,"max_size_mb":null,"applies_to":"both"},{"id":"doc-word-files","name":"Word 文档","enabled":true,"glob":"*.docx","min_size_mb":null,"max_size_mb":null,"applies_to":"both"},{"id":"ad-video-mp4","name":"广告视频-mp4","enabled":true,"glob":"*.mp4","min_size_mb":null,"max_size_mb":5,"applies_to":"both"},{"id":"ad-video-mkv","name":"广告视频-mkv","enabled":true,"glob":"*.mkv","min_size_mb":null,"max_size_mb":5,"applies_to":"both"}]
RESOURCE_CLEANUP_LOCAL_ROOTS=

# 系统登录
SYSTEM_USERNAME=admin
SYSTEM_PASSWORD=admin
SYSTEM_PASSWORD_HASH=
SYSTEM_AUTH_SECRET=
SYSTEM_PROXY_URL=
SYSTEM_PROXY_ENABLED=false
